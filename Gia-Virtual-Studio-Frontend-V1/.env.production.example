# Production build-time env vars. Copy to .env.production and fill in.
#
# DO App Platform note: if you set Build-Time env vars in the DO dashboard,
# those override what's in this file. You can either:
#   (a) check in .env.production with the deployed backend URL, or
#   (b) leave .env.production absent and set VITE_BACKEND_API_URL in DO's
#       dashboard under App Settings → Environment Variables → Build-Time.
#
# Whichever you pick, Vite must see the var BEFORE `vite build` runs.

VITE_BACKEND_API_URL=https://REPLACE_WITH_DEPLOYED_BACKEND.ondigitalocean.app
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
