# Copy this file to .env (dev) or .env.production (build for prod) and fill in
# the values. Vite inlines VITE_* vars at build time, so the production .env
# must be present BEFORE running `vite build`.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Backend API base URL. No trailing slash.
#
#   Dev:  http://127.0.0.1:8000
#   Prod: https://<your-app>.ondigitalocean.app   (set after DO deploy)
#
# Previous developer apps on this Supabase database (probe with /health
# before reusing — they may have been torn down):
#   https://stingray-app-br2fk.ondigitalocean.app
#   https://walrus-app-6ncfg.ondigitalocean.app
VITE_BACKEND_API_URL=http://127.0.0.1:8000

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Stripe publishable key (pk_test_* or pk_live_*). Safe to commit — it's
# meant to live in the browser. Only the secret key (sk_*) on the backend
# is sensitive. FREE_DEMO_MODE on the backend disables Stripe flows for
# the initial launch, so this can stay as the test key for now.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
