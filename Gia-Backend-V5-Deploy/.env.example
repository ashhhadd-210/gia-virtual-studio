# GIA Backend — Required env vars for production
# Copy to .env (or set in DigitalOcean App Platform) and fill in real values.

# ── DATABASE (REQUIRED) ─────────────────────────────────────────────────────
# Supabase Postgres pooler URL (use the pooler, not direct, for serverless).
POSTGRESQL_URI=postgresql://postgres.xxxxx:PASSWORD@aws-1-XX-XXXX.pooler.supabase.com:6543/postgres

# ── AI / LLM (REQUIRED for GSNowGPT chat) ───────────────────────────────────
OPENAI_API_KEY=sk-...

# Free tier daily message cap. Veni requested 30 messages/day (was 10).
GPT_FREE_DAILY_LIMIT=30
GPT_PAID_HOURLY_LIMIT=200

# ── AUTH (REQUIRED) ─────────────────────────────────────────────────────────
# Generate once with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-64-char-hex
JWT_EXPIRE_DAYS=7

# ── EMAIL / OTP (REQUIRED for signup) ───────────────────────────────────────
# Gmail App Password (NOT your regular Gmail password). Create at:
# https://myaccount.google.com/apppasswords  (requires 2FA enabled first)
GMAIL_SENDER_EMAIL=no-reply@yourdomain.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
OTP_EXPIRE_MINUTES=10
REQUIRE_EMAIL_VERIFICATION=true

# ── CORS (REQUIRED) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://your-frontend.example.com,https://your-other-domain.example.com
FRONTEND_URL=https://your-frontend.example.com

# ── ENVIRONMENT ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── STRIPE (OPTIONAL — initial cycle is free, leave blank) ──────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
FREE_DEMO_MODE=true

# ── ADMIN BOOTSTRAP (OPTIONAL) ──────────────────────────────────────────────
# ADMIN_BOOTSTRAP_SECRET=replace-with-random-secret

# ── PEXELS (OPTIONAL — only for blog image fetching) ────────────────────────
# PEXELS_API_KEY=

# ── DESIGN-AGENT TUNING (OPTIONAL — only relevant if running design jobs) ───
SCRAPE_INTERVAL_HOURS=1
MIN_SOURCE_ARTICLES=1
MAX_PER_SOURCE=1
CANDIDATE_LIMIT=40
MAX_SCRAPE_RETRIES=5
RETRY_DELAY_SECONDS=30
URL_REUSE_DAYS=7
PROXY_VOTE_INTERVAL_HOURS=24
